{
    "name": "norialabs/keel",
    "description": "Modular application infrastructure for Laravel: workspace tenancy, role-based access control, audit logging, passwordless authentication, invitations, and database operations.",
    "keywords": [
        "laravel",
        "multi-tenancy",
        "row-level-security",
        "postgres",
        "rbac",
        "audit-trail",
        "passwordless"
    ],
    "license": "MIT",
    "homepage": "https://github.com/norialabs/keel",
    "support": {
        "issues": "https://github.com/norialabs/keel/issues",
        "source": "https://github.com/norialabs/keel"
    },
    "type": "library",
    "authors": [
        {
            "name": "Joseph Gitonga",
            "email": "thekiharani@gmail.com",
            "homepage": "https://github.com/thekiharani"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Noria\\Keel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noria\\Keel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noria\\Keel\\KeelServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "laravel/sanctum": "Required only for PersonalAccessToken, the workspace-scoped token model."
    }
}
